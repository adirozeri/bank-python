{
  "info": {
    "name": "bank-python",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "http://localhost:8000/health" }
    },
    {
      "name": "Create Transaction",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"ACC-0001\",\n  \"amount\": 125.50,\n  \"type\": \"debit\",\n  \"status\": \"completed\",\n  \"category\": \"groceries\"\n}"
        },
        "url": "http://localhost:8000/transactions"
      }
    },
    {
      "name": "List Transactions",
      "request": { "method": "GET", "url": "http://localhost:8000/transactions" }
    },
    {
      "name": "Get Transaction",
      "request": { "method": "GET", "url": "http://localhost:8000/transactions/PASTE_ID_HERE" }
    },
    {
      "name": "Ask (LLM) - new conversation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"show me the transactions for account ACC-0001\"\n}"
        },
        "url": "http://localhost:8000/ask"
      },
      "response": [
        {
          "name": "answer",
          "body": "{\n  \"thread_id\": \"<copy this into the follow-up to continue the chat>\",\n  \"answer\": \"Here are the latest transactions for ACC-0001 ...\",\n  \"queries\": [\n    {\n      \"tool\": \"list_transactions\",\n      \"sql\": \"SELECT ...\",\n      \"rows\": []\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "Ask (LLM) - follow-up (same thread)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"what about its balance?\",\n  \"thread_id\": \"PASTE_THREAD_ID_FROM_PREVIOUS_RESPONSE\"\n}"
        },
        "url": "http://localhost:8000/ask"
      }
    },
    {
      "name": "Ask (LLM) - transfer Step 1: request",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"I'm ACC-0001, transfer 100 USD to ACC-0002\"\n}"
        },
        "url": "http://localhost:8000/ask"
      },
      "response": [
        {
          "name": "awaiting confirmation",
          "body": "{\n  \"thread_id\": \"<reuse this in Step 2>\",\n  \"answer\": \"Please confirm: transfer 100.0 USD from ACC-0001 to ACC-0002? (yes/no)\"\n}"
        }
      ]
    },
    {
      "name": "Ask (LLM) - transfer Step 2: confirm with 'yes'",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"yes\",\n  \"thread_id\": \"PASTE_THREAD_ID_FROM_STEP_1\"\n}"
        },
        "url": "http://localhost:8000/ask"
      }
    }
  ]
}

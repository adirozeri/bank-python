# Copy to .env and fill in real values. Never commit the real .env.

# LLM providers. Models are defined as a catalog and mapped per role in
# app/llm/llm_models.yaml. Set the key for whichever providers your roles actually use.
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...   # only needed if a role points at an `anthropic` catalog LLM

# Database (Phase 1: local SQLite)
DATABASE_URL=sqlite:///./bank.db

# AWS / S3: credentials come from ~/.aws/credentials (default profile); nothing to set here.

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=bank-python
